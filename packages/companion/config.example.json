{
  "// 1": "=== 模型 ===",
  "apiKey": "sk-在这里填你的 key",
  "baseUrl": "https://api.deepseek.com/v1",
  "model": "deepseek-chat",
  "// 1.1": "model 填 API 的模型 id（deepseek-chat / deepseek-flash），不是显示名 DeepSeek-V4.1-Flash",
  "// 2": "=== 角色 ===",
  "roleCard": "role.md",
  "roleMaxChars": 12000,
  "// 3": "=== 她是谁 ===",
  "names": [
    "小鱼",
    "小助手"
  ],
  "keywords": [
    "小鱼",
    "在吗"
  ],
  "ownerIds": [
    "你的QQ号"
  ],
  "// 4": "=== OneBot（NapCat / Lagrange / SnowLuma 都行）===",
  "onebot": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "",
    "httpAccessToken": ""
  },
  "// 4.1": "httpAccessToken：HTTP 和 WS 的 token 不一样时填（SnowLuma 可以分开配），一样就留空",
  "// 5": "=== 什么时候说话 ===",
  "wake": {
    "groupAtOnly": true,
    "privateOwnerOnly": false,
    "allowGroups": [],
    "probability": 0.05,
    "privateWindowMs": 1500,
    "groupWindowMs": 6000
  },
  "// 6": "=== 怎么说话（拟人化）===",
  "humanize": {
    "enabled": true,
    "msPerChar": 110,
    "minMs": 1200,
    "maxMs": 6000,
    "jitter": 0.2,
    "burstMax": 4,
    "gapRange": [
      700,
      2600
    ],
    "longGapChance": 0.3,
    "longGapRange": [
      3000,
      9000
    ],
    "typingMinChars": 20,
    "typingMinIntervalMs": 45000,
    "typingProbability": 0.35
  },
  "// 6.1": "=== 发送限频 + 熔断（防风控，别调高）===",
  "send": {
    "perMinute": 6,
    "perHour": 80,
    "failThreshold": 3,
    "cooldownMs": 180000
  },
  "// 6.2": "=== 看图（只从 QQ 图床下载，每轮最多几张、每张多大）===",
  "images": {
    "enabled": true,
    "maxCount": 3,
    "maxBytes": 5242880,
    "timeoutMs": 15000
  },
  "// 6.3": "=== 联网搜索（DeepSeek 的 web_search 服务端工具；apiKey 不填就用上面聊天的 key）===",
  "webSearch": {
    "enabled": false,
    "model": "deepseek-chat",
    "maxUses": 2,
    "maxResults": 6,
    "timeoutMs": 30000
  },
  "// 7": "=== 数据存哪（账本 + 对话流）===",
  "dataDir": "data",
  "// 8": "=== 日记（她自己写）===",
  "diaryDir": "data/diary",
  "diaryMaxChars": 2000,
  "// 9": "=== 长期记忆服务（可选，companion_memory 的 server.py；不填 url 就只用本地账本，目前只接私聊）===",
  "memoryService": {
    "url": "",
    "timeoutMs": 8000,
    "maxToolRounds": 3
  }
}
